#!/bin/sh
# Work around the host librsvg2-common 2.63.4 broken SVG loader magic: any
# .svg/.svgz icon fails flatpak-validate-icon with "Format not recognized"
# on this machine (CI's container has a working loader). Skip validation for
# SVGs only; exec the real validator for everything else. The icon file is
# never modified. (See docs/notes + v01 build workaround.)
for arg in "$@"; do
    case "$arg" in
        *.svg|*.svgz|*.SVG|*.SVGZ)
            exit 0
            ;;
    esac
done
exec /usr/libexec/flatpak-validate-icon "$@"
