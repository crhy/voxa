#!/bin/sh

# GTK 4 can leave stale damage fragments on some NVIDIA + X11/Compiz
# combinations. Keep the GL renderer and force complete redraws on X11 via
# GSK_DEBUG below. (Do NOT set GDK_DISABLE=incremental-present here: current
# GTK rejects the value as unrecognized and refuses to start.)
: "${GSK_RENDERER:=gl}"
export GSK_RENDERER

if [ "${XDG_SESSION_TYPE:-}" = "x11" ] || { [ -n "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; }; then
  case ",${GSK_DEBUG:-}," in
    *,full-redraw,*) ;;
    *) GSK_DEBUG="${GSK_DEBUG:+$GSK_DEBUG,}full-redraw" ;;
  esac
  export GSK_DEBUG
fi

# Expose the bundled CUDA compute libraries (cuBLAS/cuDNN runtime) so Faster
# Whisper can use the GPU inside the Flatpak sandbox.
export LD_LIBRARY_PATH="/app/lib/cuda${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Expose the bundled NVIDIA NVML tools (nvidia-smi + libnvidia-ml) so the app
# can probe the host GPU for model sizing and the live GPU/percent widgets.
# nvidia-smi is looked up on PATH; its libnvidia-ml.so.1 dependency is
# dlopened and resolved from LD_LIBRARY_PATH. Bundled because the GNOME 50
# runtime ships neither.
export PATH="/app/lib/nvml${PATH:+:$PATH}"
export LD_LIBRARY_PATH="/app/lib/nvml${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec python3 /app/lib/voxa/voxa.py "$@"
